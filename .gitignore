.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment variables
.env
.env.local
.env.production

# Log files
*.log
logs/

# Temporary files
tmp/
temp/

# Configuration files (if they contain secrets)
config.yaml
config.json
!config.example.yaml
!config.example.json

